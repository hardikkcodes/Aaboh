# =============================================================================
# Civic Climate Intelligence Platform — environment template
# Copy to .env and fill in values. NEVER commit a real .env file.
# The application starts with all external providers unconfigured; modules
# then report their status as UNAVAILABLE instead of fabricating data.
# =============================================================================

# --- Product branding (do not hardcode a brand name in code) ---
APP_NAME="Civic Climate"
APP_SHORT_NAME="CivicClimate"
APP_TAGLINE="Hyperlocal environmental intelligence for Kolkata"
APP_SUPPORT_EMAIL=""
FRONTEND_URL="http://localhost:5173"
PUBLIC_SITE_URL="http://localhost:8000"

# --- Django ---
DJANGO_SECRET_KEY="dev-only-change-me-in-production"
DJANGO_DEBUG="true"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_LOG_LEVEL="INFO"
DJANGO_CSRF_TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
DJANGO_LOG_FORMAT="plain"
# Reverse proxies in front of Django: 0 direct, 1 nginx, 2 nginx plus a TLS proxy.
DJANGO_NUM_PROXIES="0"
# Production requires DJANGO_DEBUG="false" and a random secret of 50+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Optional production overrides, shown with their defaults:
# DJANGO_SECURE_SSL_REDIRECT="true"
# DJANGO_SECURE_HSTS_SECONDS="2592000"
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS="false"
# DJANGO_SECURE_HSTS_PRELOAD="false"
# DJANGO_CACHE_DIR=""   # shared rate-limit storage for multiple workers

# --- Database ---
# Development default is SQLite (no Docker required).
# Production target is PostgreSQL + PostGIS (use docker compose, DB_ENGINE=postgres).
DB_ENGINE="sqlite"
POSTGRES_DB="civic_climate"
POSTGRES_USER="civic"
POSTGRES_PASSWORD="change-me"
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"

# --- CORS ---
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Data providers (optional; leave blank to keep module UNAVAILABLE) ---
# Open-Meteo requires no key and is enabled by default.
OPEN_METEO_ENABLED="true"
OPEN_METEO_TIMEOUT_SECONDS="30"

# India Meteorological Department official warnings.
# The public API returns {"error":"API key missing"} without a key. Header name
# must be confirmed with IMD; we default to X-API-Key (configurable).
IMD_API_KEY=""
IMD_API_KEY_HEADER="X-API-Key"
IMD_BASE_URL="https://api.imd.gov.in/api/v1"

# Central Pollution Control Board via data.gov.in.
CPCB_API_KEY=""
CPCB_RESOURCE_ID="3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69"
CPCB_BASE_URL="https://api.data.gov.in/resource"
CPCB_TIMEOUT_SECONDS="60"
CPCB_CITIES="Kolkata,Howrah"

# SACHET / NDMA official alerts (no key required).
SACHET_BASE_URL="https://sachet.ndma.gov.in"
SACHET_TIMEOUT_SECONDS="45"
SACHET_SCOPE_TERMS="kolkata,howrah,haora,hooghly,24 parganas,west bengal"

# Google Earth Engine / Landsat pipeline (not required for the web app).
GEE_PROJECT_ID=""
GEE_SERVICE_ACCOUNT_EMAIL=""
GEE_SERVICE_ACCOUNT_KEY_FILE=""

# Copernicus CDS (optional direct ERA5-Land access; Open-Meteo archive is used
# as the default ERA5-Land access path and needs no key).
CDS_API_URL="https://cds.climate.copernicus.eu/api"
CDS_API_KEY=""

# Optional Telegram delivery for personal alerts. In-app alerts work without it.
TELEGRAM_BOT_TOKEN=""

# --- Uploads ---
INCIDENT_IMAGE_MAX_BYTES="5242880"

# --- Frontend (Vite reads VITE_* at build time) ---
VITE_API_BASE_URL="/api/v1"
